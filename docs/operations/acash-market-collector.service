# acash-market-collector.service
# TEMPLATE — installed by scripts/deploy/deploy_acash_collector.sh on the Acer host.
# Research-only market-data acquisition: NO_REAL_ORDERS=true, capital authority USD 0.00, no broker calls.
#
# Layout (see docs/operations/market-data-collector-homelab.md):
#   /data/acash/app    code (root-owned, read-only to the service user)
#   /data/acash/state  ACASH_PRIVATE_DIR (mew-owned 0700): warehouse, health, FX artifacts
#   /data/acash/venv   python + pyarrow
#   /etc/acash/market-data.env  credentials (root 0600), read by systemd before dropping privileges

[Unit]
Description=ACASH daily market-data collector (research only, no orders)
Documentation=file:///data/acash/app/docs/operations/market-data-collector-homelab.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=mew
Group=mew
WorkingDirectory=/data/acash/app
Environment=PYTHONPATH=/data/acash/app/src
Environment=ACASH_PRIVATE_DIR=/data/acash/state/private
Environment=ACASH_NO_REAL_ORDERS=true
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/acash/market-data.env
# --catch-up: after the incremental pass, symbols with middle gaps (missed while offline) are refetched
# over the bounded window, one pass only, inside the same request budget.
ExecStart=/data/acash/venv/bin/python /data/acash/app/scripts/daily_market_collector.py --catch-up
# A failure is evidence for investigation, not an automatic retry loop.
Restart=no
TimeoutStartSec=1800
TimeoutStopSec=60
MemoryMax=512M
CPUQuota=50%
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/acash/state
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

# No [Install]: the timer starts this oneshot, so `systemctl enable` on the service fails closed.
