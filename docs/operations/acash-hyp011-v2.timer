# acash-hyp011-v2.timer
# CANONICAL TIMER TEMPLATE — never install this bare file: without a trigger
# systemd refuses it (Timer unit lacks value setting). Authority A installs
# NO timer. Authority B generates the installed unit from this template with
# the validated OnCalendar trigger, and only then enables it.
#
# One governed session per invocation. Timer triggers the service with
# environment variables set via drop-in or systemd-environment-d generator.
# The actual authorization values are injected at activation time.

[Unit]
Description=ACASH HYP_011 V2 Prospective Shadow Observation Timer
Documentation=file:///home/mew/Acash/docs/operations/HYP_011_V2_HOMELAB_DEPLOYMENT.md
# No Requires=/Wants= on the service here: a timer named
# acash-hyp011-v2.timer already activates acash-hyp011-v2.service on elapse.
# A Requires= dependency would risk pulling the service up immediately when
# the timer is enabled instead of waiting for the scheduled elapse.

[Timer]
Unit=acash-hyp011-v2.service
# No OnCalendar here by design: the exact fire time is derived from canonical
# candidate_schedule_time() (session.close_utc + 15-minute SIP delay +
# 5-minute operational margin) and provided as a UTC expression by a
# per-session drop-in ONLY under AUTHORIZE_HYP_011_V2_ACTIVATION_<SESSION>,
# e.g.:
#   [Timer]
#   OnCalendar=
#   OnCalendar=2026-10-06 20:20:00 UTC
# (Exact value is calendar-derived per session; never hardcode an offset.
# Never use a Timezone= directive: the expression is already UTC-normalized.)
# Without the drop-in this timer never fires. The unit is installed but
# DISABLED until ACTIVATION authority.
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
RemainAfterElapse=false

[Install]
WantedBy=timers.target