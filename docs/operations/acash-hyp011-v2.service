# acash-hyp011-v2.service
# Systemd service for HYP_011 V2 prospective shadow observation
# Template only — NOT INSTALLED without AUTHORIZE_HYP_011_V2_CANONICAL_DEPLOYMENT
# 
# V2 Architecture:
# - Repository code: /home/mew/Acash (immutable deployment checkout)
# - Mutable state: /var/lib/acash/hyp011/v2 (external to git)
# - Secrets: /etc/acash/hyp011-v2.env (0600, separate from state)
# - Python: explicit pinned interpreter from .venv
# - Zero restart loop, fail-closed, one governed session per invocation

[Unit]
Description=ACASH HYP_011 V2 Prospective Shadow Observation
Documentation=file:///home/mew/Acash/docs/operations/HYP_011_V2_HOMELAB_DEPLOYMENT.md
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# No restart loop — each invocation is one atomic session
# Failure = investigation required, not automatic retry

[Service]
Type=oneshot
User=mew
Group=mew
WorkingDirectory=/home/mew/Acash
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/acash/hyp011-v2.env
# The executed binary is the INSTALLED deployment copy, never the tracked
# repository file (which stays mode 0644). Installed under Authority A via:
#   sudo install -o root -g root -m 0755 \
#     /home/mew/Acash/docs/operations/acash-hyp011-v2.sh \
#     /usr/local/sbin/acash-hyp011-v2
# The unit carries BARE mode flags only. Every session binding
# (AUTHORIZATION, ORDINAL, DISPATCH_ATTEMPT, DISPATCH_AUTHORITY,
# CA_DETERMINATIONS, CA_EVIDENCE_BUNDLE, RUNTIME_SHA,
# SEGMENT_ACTIVATION_AUTHORITY) arrives via a systemd drop-in Environment=
# set ONLY under AUTHORIZE_HYP_011_V2_ACTIVATION_<SESSION>, and the wrapper
# builds the deterministic runner invocation from it: required bindings must
# be present (else fail closed), optional CA inputs are passed ONLY when
# actually set — never as empty expansions, never as fabricated evidence.
# This template alone can never dispatch: without the drop-in the wrapper
# fails closed (missing AUTHORIZATION / activation authority).
#
# Unattended elapse-time gate: ExecStartPre replays the FULL zero-network
# dispatch preflight (authorities, intent, CA, freshness, guards) at the
# actual dispatch instant, consuming nothing and touching no network. If it
# fails, systemd never runs ExecStart — no market-data call, no attempt
# consumed, no retry (Restart=no). This is what makes the timer truly
# unattended: preflight cannot usefully run at ARM time because the session
# has not closed yet (it would fail SHADOW_INCOMPLETE_SESSION by design),
# so the gate MUST live at elapse time, not in the arming procedure.
ExecStartPre=/usr/local/sbin/acash-hyp011-v2 --local-preflight
ExecStart=/usr/local/sbin/acash-hyp011-v2 --execute-network
# Fail closed: no restart, no retry
Restart=no
TimeoutStartSec=300
TimeoutStopSec=30
# Resource limits
MemoryMax=512M
CPUQuota=50%
# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/acash/hyp011/v2
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# No [Install] section by design: this oneshot service is started ONLY by
# its timer at elapse time. Omitting [Install] makes `systemctl enable`
# fail closed, so the service can never introduce automatic startup.